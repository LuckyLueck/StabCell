Package: StabCell
Type: Package
Title: StabCell: Stable Clustering & Differential Expression for Single-cell RNA Sequencing Data
Version: 0.1.1
Authors@R: c(
              person("Niklas", "Lück", role = c("aut", "cre"),
                     email="lueck@statistik.tu-dortmund.de"),
              person("Christian", "Staerk", role = "aut",
