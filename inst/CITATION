bibentry(
        bibtype="Article",
        key="StabCellArticle",
        title="{StabCell}: Stability selection for clustering and marker detection in single-cell {RNA} sequencing",
        author=c(
           as.person("Niklas L\\\"uck"),
           as.person("Andrea Rossi"),
           as.person("Christian Staerk")
