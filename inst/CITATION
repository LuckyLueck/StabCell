vers <- "0.1.1"

bibentry(
         bibtype="Manual",
         key="StabCellSoftware",
         title="{StabCell}: Stability selection for single-cell {RNA} sequencing",
         author=c(as.person("Niklas L\\\"uck"), as.person("Andrea Rossi"), as.person("Christian Staerk")),
         year=year,
         note=paste("{R} package version", vers),
         url="https://github.com/LuckyLueck/StabCell",
