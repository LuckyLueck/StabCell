citHeader("To cite package 'StabCell' in publications use:")

year <- 2026
vers <- "0.1.0"

bibentry(
         bibtype="Manual",
         key="LueckStabCell",
         title="{StabCell}: Stable Clustering & Differential Expression for Single-cell {RNA} Sequencing Data",
         author=c(as.person("Niklas L\\\"uck"), as.person("Christian Staerk")),
         year=year,
         note=paste("{R} package version", vers),
         url="https://github.com/LuckyLueck/StabCell",
         textVersion=paste0(
             "Niklas Lück and Christian Staerk (", year,"). ",
             "StabCell: Stability Selection with Error Control, ",
             "R package version ", vers,", ",
             "https://github.com/LuckyLueck/StabCell."
         )
)

